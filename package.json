{
  "name": "multiverso",
  "private": true,
  "version": "0.1.0",
  "description": "Multiverso — sistema modular de gestao para restaurantes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:gerar": "node scripts/gerar-seed.mjs",
    "seed:conferir": "node scripts/conferir-seed.mjs",
    "test:banco": "supabase/testes/preparar-postgres.sh > /dev/null && supabase/testes/executar.sh",
    "verificar": "npm run typecheck && npm test && npm run build && npm run test:banco",
    "funcao:preparar": "node ferramentas/preparar-funcao.mjs",
    "implantar": "ferramentas/implantar.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^4.5.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.14.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
