# Projeto Supabase do Multiverso
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Usado apenas pelos scripts de carga (nunca vai para o navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Conexao direta ao Postgres, usada so pelo `npm run carga`.
# Os valores saem do painel do Supabase em Connect -> Connection parameters.
#
# Copie este arquivo para .env.local (que o .gitignore ja cobre) e preencha.
# Com ele no lugar, `npm run carga` funciona em qualquer janela do terminal,
# sem redigitar a senha — variavel de PowerShell ($env:...) morre junto com a
# janela, e redigitar senha e como se erra senha.
#
# PGPASSWORD vai inteira, como foi digitada: aqui nao ha o `@` separador da
# string de conexao, entao nao existe o que escapar.
PGHOST=db.SEU-PROJETO.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=a-senha-do-banco
